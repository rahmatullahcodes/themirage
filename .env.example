# The Mirage - Environment Variables Template
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/the_mirage_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="your_production_secure_jwt_secret_key_here"

# Public App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Revenue Share Configuration (Configurable)
CREATOR_COMMISSION_PERCENT=85
PLATFORM_COMMISSION_PERCENT=15

# Payment Gateway Sandbox Credentials
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_KEY=mirage_sandbox_key_example
PAYMENT_GATEWAY_SECRET=mirage_sandbox_secret_example
PAYMENT_WEBHOOK_SECRET=mirage_webhook_secret_example

# S3-Compatible Private Storage
S3_BUCKET=the-mirage-private-vault
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

