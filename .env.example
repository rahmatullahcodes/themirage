# The Mirage - Environment Variables Template
PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/the_mirage_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="your_production_secure_jwt_secret_key_here"

# Public App Base URL (Live Production Domain)
NEXT_PUBLIC_APP_URL="https://themirage.world"

# Revenue Share Configuration (Configurable)
CREATOR_COMMISSION_PERCENT=85
PLATFORM_COMMISSION_PERCENT=15

# PayRam Self-Hosted Crypto Payment Gateway (Subdomain: pay.themirage.world)
# Modes: AUTO (live when PAYRAM_API_KEY set) | PAYRAM | SANDBOX
PAYMENT_GATEWAY_MODE=AUTO
PAYRAM_BASE_URL="https://pay.themirage.world"
PAYRAM_API_KEY=""
PAYRAM_WEBHOOK_SECRET=""

# S3-Compatible Private Storage (Optional)
S3_BUCKET=the-mirage-private-vault
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
